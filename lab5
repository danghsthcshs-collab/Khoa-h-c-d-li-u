-- PHẦN I: Bài 1 
-- 1. INNER JOIN
SELECT oi.order_id, p.product_name, oi.quantity, p.price
FROM orderdetails oi
INNER JOIN products p ON oi.product_id = p.product_id;

-- 2. LEFT JOIN
SELECT c.full_name, o.order_id
FROM customers c
LEFT JOIN orders o ON c.customer_id = o.customer_id;


-- Bài 2: 
-- 1. RIGHT JOIN
SELECT p.product_name, oi.order_id
FROM orderdetails oi
RIGHT JOIN products p ON oi.product_id = p.product_id;

-- 2. UNION
SELECT full_name AS ContactName, phone_number AS PhoneNumber FROM customers
UNION
SELECT supplier_name, contact_phone FROM suppliers;


-- PHẦN II: Bài 3 
-- 1. Subquery với IN
SELECT product_name, price
FROM products
WHERE supplier_id IN (
    SELECT supplier_id 
    FROM suppliers 
    WHERE supplier_name = 'Công ty Sữa Việt Nam'
);

-- 2. Subquery trong SELECT
SELECT product_name, price, 
    (SELECT AVG(price) FROM products) AS average_price
FROM products;


-- Bài 4: 
-- 1. Subquery trong FROM
SELECT order_id, total_value
FROM (
    SELECT oi.order_id, SUM(oi.quantity * p.price) AS total_value
    FROM orderdetails oi
    JOIN products p ON oi.product_id = p.product_id
    GROUP BY oi.order_id
) AS temp_table
WHERE total_value > 50000;

-- 2. EXISTS
SELECT supplier_name
FROM suppliers s
WHERE EXISTS (
    SELECT 1 
    FROM products p 
    WHERE p.supplier_id = s.supplier_id
);
